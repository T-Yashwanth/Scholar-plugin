{
  "description": "Ensures python-docx is available for .docx generation",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-deps.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
